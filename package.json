{
  "name": "revenue-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard de revenue de protocolos crypto con ventanas de 8h y alertas",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup:adapters": "bash deploy/setup-adapters.sh",
    "collect": "node --disable-warning=ExperimentalWarning --import tsx src/collect.ts",
    "backfill": "node --disable-warning=ExperimentalWarning --import tsx src/collect.ts --backfill-days 14",
    "serve": "node --disable-warning=ExperimentalWarning --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "demo:seed": "node --disable-warning=ExperimentalWarning --import tsx src/demo-seed.ts",
    "probe:solana": "node --disable-warning=ExperimentalWarning --import tsx src/probe-solana.ts",
    "validate": "node --disable-warning=ExperimentalWarning --import tsx src/validate.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
