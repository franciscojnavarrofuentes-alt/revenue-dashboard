{
  "name": "revenue-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Revenue del d\u00eda en curso del Top 100 de DefiLlama, por horas, con alertas",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup:adapters": "bash deploy/setup-adapters.sh",
    "discover": "node --disable-warning=ExperimentalWarning --import tsx src/discover.ts",
    "calibrate": "node --disable-warning=ExperimentalWarning --import tsx src/calibrate.ts",
    "collect": "node --disable-warning=ExperimentalWarning --import tsx src/collect.ts",
    "serve": "node --disable-warning=ExperimentalWarning --import tsx src/server.ts",
    "validate": "node --disable-warning=ExperimentalWarning --import tsx src/validate.ts",
    "demo:seed": "node --disable-warning=ExperimentalWarning --import tsx src/demo-seed.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
