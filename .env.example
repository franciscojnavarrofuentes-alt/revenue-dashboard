# Helius (Axiom y GMGN en Solana). Plan gratuito: 1M créditos/mes. https://dashboard.helius.dev
HELIUS_API_KEY=

# Dune: desactivado (sin créditos). Con ENABLE_DUNE=true se calibran también los adapters que usan Dune.
DUNE_API_KEYS=
ENABLE_DUNE=false

# Opcional: algunos adapters piden claves gratuitas (p. ej. FRED_API_KEY). La calibración las lista como "necesita clave".

# Telegram (opcional; sin esto las alertas solo se ven en el dashboard)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard
PORT=3000
DASHBOARD_USER=
DASHBOARD_PASS=

# Universo y medición
TOP_N=100
HOUR_LAG_MIN=10
CATCHUP_HOURS=3
BATCH_CONCURRENCY=4
CALIB_MIN_DAILY_USD=1000

# Alertas
ALERT_TODAY_PCT=40
ALERT_MIN_HOURS=4
ALERT_HOUR_PCT=100
ALERT_MIN_DAILY_USD=50000
