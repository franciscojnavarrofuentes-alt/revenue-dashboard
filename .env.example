# Helius (Axiom y GMGN en Solana). Plan gratuito: 1M créditos/mes. https://dashboard.helius.dev
HELIUS_API_KEY=

# Dune (solo Pump). Requiere créditos; pon ENABLE_DUNE=true para activarlo.
DUNE_API_KEYS=
ENABLE_DUNE=false

# Telegram (opcional; sin esto las alertas solo se guardan y se ven en el dashboard)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard
PORT=3000
# Si se rellenan, el dashboard pide usuario y contraseña (recomendado en un VPS público)
DASHBOARD_USER=
DASHBOARD_PASS=

# Reglas de alerta
ALERT_ZSCORE=2
ALERT_PCT_VS_YESTERDAY=50
# Ventanas de 8h mínimas de histórico antes de evaluar el z-score (9 = 3 días)
ALERT_MIN_HISTORY=9

# Número de protocolos del ranking de DefiLlama
TOP_N=10
